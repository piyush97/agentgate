{
  "name": "@piyush97/agentgate",
  "version": "0.1.0",
  "description": "Block AI-agent PRs that weaken tests, edit guardrails, or escalate CI permissions",
  "type": "module",
  "license": "MIT",
  "author": "Piyush Mehta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piyush97/agentgate.git"
  },
  "keywords": [
    "github-action",
    "ai-agents",
    "security",
    "ci",
    "code-review"
  ],
  "bin": {
    "agentgate": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.ts'",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
